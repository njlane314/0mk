# Example Rivetfile. The commands are illustrative application contracts.

all <- report.pdf

case.tar.zst <- geometry.mesh parameters.toml @local
	./pack $^ --output $@

result.json <- case.tar.zst @large
	./solve --input $< --output $@

report.pdf <- result.json @local
	./report $< --output $@

publish! <- report.pdf @local
	./publish $<
